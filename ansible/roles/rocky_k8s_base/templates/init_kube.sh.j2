#!/bin/bash
# Ansible managed: Kubernetes initialization script for {{ inventory_hostname }}
set -e 

# 1. Get the name of the first master host from the control_nodes group
{% set first_master = groups['control_nodes'][0] %}
# 2. Get that host's defined hostname and split it to get the short name
{% set short_name = hostvars[first_master]['hostname'].split('.')[0] %}

echo "--- Loading Kernel Modules ---"
sudo modprobe overlay
sudo modprobe br_netfilter

echo "--- Configuring Sysctl ---"
cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
EOF

sudo sysctl --system

echo "--- Managing Services ---"
sudo systemctl disable --now firewalld
sudo systemctl daemon-reload
sudo systemctl enable --now crio
sudo systemctl enable --now kubelet

echo "--- Validating CRI-O Socket ---"
for i in {1..20}; do
    if [ -S /var/run/crio/crio.sock ]; then
        echo "Socket ready."
        break
    fi
    echo "Waiting for socket... ($i/20)"
    sleep 1
done

if [ ! -f /etc/kubernetes/admin.conf ]; then
    echo "--- Initializing Cluster ---"
    sudo kubeadm init \
      --control-plane-endpoint '{{ short_name }}:6443' \
      --upload-certs \
      --pod-network-cidr=10.244.0.0/16 \
      --apiserver-advertise-address={{ provision_ip }} \
      --cri-socket unix:///var/run/crio/crio.sock \
      --ignore-preflight-errors=Swap,SystemVerification
else
    echo "NOTICE: Cluster is already initialized."
fi