#!/usr/bin/env bash
# Wrapper to run virsh against remote libvirt via qemu+ssh

# Environment overrides take precedence; Ansible can still set these if needed.
KVM_HOST="${KVM_HOST:-${LIBVIRT_KVM_HOST:-home}}"
REMOTE_USER="${REMOTE_USER:-{{ cloud_helper_user }}}"

# Auto-activate cloud_helper venv only if not already active
if [ -z "$VIRTUAL_ENV" ] && [ -f "/opt/cloud_helper/venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  source /opt/cloud_helper/venv/bin/activate
fi

# Validate arguments
if [ "$#" -eq 0 ]; then
  echo "Usage: $0 <virsh subcommand> [args...]" >&2
  exit 2
fi

# Use SSH config (Host home) to resolve key, strict host checking, user, etc.
# KVM_HOST usually "home" here, but can be overridden via env.
exec ssh "${KVM_HOST}" -- "virsh \"$@\"" 2>&1 \
  | grep -vi '^Warning: Permanently added'
