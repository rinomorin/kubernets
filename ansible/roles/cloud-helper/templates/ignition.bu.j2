variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - {{ helper_ssh_key }}

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ hostname }}

    - path: /home/core/.ssh/config
      mode: 0600
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          Host *
              StrictHostKeyChecking accept-new
              UserKnownHostsFile ~/.ssh/known_hosts

    # NIC 1 (enp1s0) - DHCP
    - path: /etc/NetworkManager/system-connections/enp1s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp1s0
          type=ethernet
          interface-name=enp1s0
          [ipv4]
          method=auto

    # NIC 2 (enp2s0) - Static Cluster IP
    - path: /etc/NetworkManager/system-connections/enp2s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp2s0
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          address1={{ cluster_ip }}/24
          method=manual

{% if provider_ip is defined %}
    # NIC 3 (enp3s0) - Static Default/Bridge IP
    - path: /etc/NetworkManager/system-connections/enp3s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp3s0
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          address1={{ provider_ip }}/24
          method=manual
{% endif %}

    # Bootstrap script (corrected)
    - path: /usr/local/bin/cloud-helper-bootstrap.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail

          HOSTNAME=$(hostname)
          IP=$(hostname -I | awk '{print $1}')

          curl -X POST \
            -F "hostname=${HOSTNAME}" \
            -F "ip=${IP}" \
            http://172.16.0.20:8081/register

systemd:
  units:
    # 1. Install Kubernetes prerequisites on first boot
    - name: k8s-prereqs-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Kubernetes prerequisites via rpm-ostree
        ConditionPathExists=!/var/lib/k8s-installed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/rpm-ostree install cri-o cri-tools kubelet kubeadm kubectl
        ExecStart=/usr/bin/touch /var/lib/k8s-installed
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # 2. Cloud Helper Bootstrap (runs AFTER prereqs are installed)
    - name: cloud-helper-bootstrap.service
      enabled: true
      contents: |
        [Unit]
        Description=Cloud Helper Bootstrap Registration
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=/var/lib/k8s-installed

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/cloud-helper-bootstrap.sh

        [Install]
        WantedBy=multi-user.target
