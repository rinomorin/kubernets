variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - {{ helper_ssh_key }}

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ hostname }}

    - path: /home/core/.ssh/config
      mode: 0600
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          Host *
              StrictHostKeyChecking accept-new
              UserKnownHostsFile ~/.ssh/known_hosts

    # NIC 1 (enp1s0) - DHCP
    - path: /etc/NetworkManager/system-connections/enp1s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp1s0
          type=ethernet
          interface-name=enp1s0
          [ipv4]
          method=auto

    # NIC 2 (enp2s0) - Static Cluster IP
    - path: /etc/NetworkManager/system-connections/enp2s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp2s0
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          address1={{ cluster_ip }}/24
          method=manual

{% if provider_ip is defined %}
    # NIC 3 (enp3s0) - Static Default/Bridge IP
    - path: /etc/NetworkManager/system-connections/enp3s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp3s0
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          address1={{ provider_ip }}/24
          method=manual
{% endif %}

    # Cloud Helper Registration Script
    - path: /usr/local/bin/cloud-helper-bootstrap.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail
          HOSTNAME=$(hostname)
          IP=$(hostname -I | awk '{print $1}')
          curl -X POST \
            -F "hostname=${HOSTNAME}" \
            -F "ip=${IP}" \
            http://172.16.0.20:8081/register

    # Kubernetes v1.34.0 Binary Installer
    - path: /usr/local/bin/install-k8s-binaries.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail
          VERSION="v1.34.0"
          ARCH="amd64"
          BASE_URL="https://dl.k8s.io/release/${VERSION}/bin/linux/${ARCH}"
          BIN_DIR="/usr/local/bin"

          download() {
              local bin="$1"
              curl -L --fail "${BASE_URL}/${bin}" -o "${BIN_DIR}/${bin}"
              chmod +x "${BIN_DIR}/${bin}"
          }

          echo "Downloading Kubernetes ${VERSION} binaries..."
          download kubeadm
          download kubelet
          download kubectl

          echo "Kubernetes binaries installed."
          touch /var/lib/k8s-binaries-installed

    # Kubelet systemd unit
    - path: /etc/systemd/system/kubelet.service
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=kubelet: The Kubernetes Node Agent
          After=network-online.target
          Wants=network-online.target

          [Service]
          ExecStart=/usr/local/bin/kubelet $KUBELET_EXTRA_ARGS
          Restart=always
          StartLimitInterval=0
          RestartSec=10

          [Install]
          WantedBy=multi-user.target

    # Kubelet CRI-O drop-in
    - path: /etc/systemd/system/kubelet.service.d/10-crio.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Service]
          Environment="KUBELET_EXTRA_ARGS=--container-runtime-endpoint=unix:///var/run/crio/crio.sock"

    # CRI-O config directory (runtime tuning)
    - path: /etc/crio/crio.conf.d/00-default.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [crio.runtime]
          conmon_cgroup = "pod"
          cgroup_manager = "systemd"

    # Containers registries config (overwrite FCOS default)
    - path: /etc/containers/registries.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [registries.search]
          registries = ["registry.fedoraproject.org", "registry.access.redhat.com", "docker.io"]

    # Containers storage config (overwrite FCOS default)
    - path: /etc/containers/storage.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [storage]
          driver = "overlay"
          runroot = "/run/containers/storage"
          graphroot = "/var/lib/containers/storage"

    # CNI config: basic bridge network for CRI-O
    - path: /etc/cni/net.d/10-crio-bridge.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          {
            "cniVersion": "0.4.0",
            "name": "crio-bridge",
            "type": "bridge",
            "bridge": "cni0",
            "isGateway": true,
            "ipMasq": true,
            "ipam": {
              "type": "host-local",
              "subnet": "10.85.0.0/16",
              "routes": [
                { "dst": "0.0.0.0/0" }
              ]
            }
          }

    # CRI-O network config: point CNI to /opt/cni/bin only
    - path: /etc/crio/crio.conf.d/01-cni-plugin-dirs.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [crio.network]
          plugin_dirs = ["/opt/cni/bin"]

    # CNI plugin installer script
    - path: /usr/local/bin/install-cni-plugins.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/bash
          set -euo pipefail
          VERSION="v1.4.0"
          URL="https://github.com/containernetworking/plugins/releases/download/${VERSION}/cni-plugins-linux-amd64-${VERSION}.tgz"
          mkdir -p /opt/cni/bin
          tmpfile=$(mktemp)
          curl -L --fail "${URL}" -o "${tmpfile}"
          tar -C /opt/cni/bin -xzf "${tmpfile}"
          rm -f "${tmpfile}"
          touch /var/lib/cni-plugins-installed

systemd:
  units:
    # 1. Install CRI-O via rpm-ostree (requires reboot)
    - name: crio-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install CRI-O via rpm-ostree
        ConditionPathExists=!/var/lib/crio-installed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/rpm-ostree install cri-o cri-tools
        ExecStart=/usr/bin/touch /var/lib/crio-installed
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # 2. Install CNI plugins (after reboot)
    - name: cni-plugins-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install CNI plugins
        ConditionPathExists=!/var/lib/cni-plugins-installed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/install-cni-plugins.sh

        [Install]
        WantedBy=multi-user.target

    # 3. Install Kubernetes v1.34.0 binaries (after reboot)
    - name: k8s-binaries-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Kubernetes v1.34.0 binaries
        ConditionPathExists=!/var/lib/k8s-binaries-installed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/install-k8s-binaries.sh

        [Install]
        WantedBy=multi-user.target

    # 4. Enable CRI-O after it is installed
    - name: enable-crio.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable CRI-O
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=/var/lib/crio-installed

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl enable --now crio

        [Install]
        WantedBy=multi-user.target

    # 5. Enable kubelet after binaries + CRI-O + CNI are present
    - name: enable-kubelet.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable kubelet
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=/var/lib/k8s-binaries-installed
        ConditionPathExists=/var/lib/crio-installed
        ConditionPathExists=/var/lib/cni-plugins-installed

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl enable --now kubelet

        [Install]
        WantedBy=multi-user.target

    # 6. Cloud Helper Bootstrap (runs last, once node is k8s-ready)
    - name: cloud-helper-bootstrap.service
      enabled: true
      contents: |
        [Unit]
        Description=Cloud Helper Bootstrap Registration
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=/var/lib/k8s-binaries-installed

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/cloud-helper-bootstrap.sh

        [Install]
        WantedBy=multi-user.target
