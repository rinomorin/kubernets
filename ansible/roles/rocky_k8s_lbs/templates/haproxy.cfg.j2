global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    
    # Turn on the stats socket for troubleshooting
    stats socket /var/lib/haproxy/stats mode 660 level admin expose-fd listeners
    stats timeout 30s

defaults
    mode                    tcp
    log                     global
    option                  tcplog
    option                  dontlognull
    option http-server-close
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

# IMPORTANT: This line tells HAProxy to load your service-specific files
# Note: In HAProxy 2.x, you can also use "extra-config-path" in systemd 
# but putting a placeholder here is a good practice.
# ADD THIS TO THE BOTTOM OF YOUR haproxy.cfg.j2
include /etc/haproxy/conf.d/*.cfg

