global
    log /dev/log local0
    log /dev/log local1 notice
    daemon
    group haproxy
    user haproxy
    maxconn 4000

defaults
    mode                    tcp
    log                     global
    option                  tcplog
    option                  dontlognull
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout check           10s
    maxconn                 3000

# --- K8S API SERVER (6443) ---
# Balances the kubectl/API traffic across the Control Plane nodes
frontend k8s-api
    bind {{ k8s_api_vip}}:6443
    default_backend k8s-masters

backend k8s-masters
    balance roundrobin
    option httpchk GET /healthz
    http-check expect status 200
    {% for host in groups['control_nodes'] %}
    server {{ host }} {{ hostvars[host].provision_ip }}:6443 check check-ssl verify none
    {% endfor %}

# --- APPLICATION TRAFFIC (HTTPS - 443) ---
# Forwards encrypted traffic to the MetalLB VIP (Ingress Controller)
frontend k8s-ingress-https
    bind {{k8s_api_vip}}:443
    default_backend k8s-ingress-backend-https

backend k8s-ingress-backend-https
    mode tcp
    balance roundrobin
    server metallb-vip 10.0.0.200:443 check

# --- APPLICATION TRAFFIC (HTTP - 80) ---
# Forwards standard web traffic to the MetalLB VIP
frontend k8s-ingress-http
    bind {{ k8s_api_vip }}:80
    default_backend k8s-ingress-backend-http

backend k8s-ingress-backend-http
    mode tcp
    balance roundrobin
    server metallb-vip 10.0.0.200:80 check